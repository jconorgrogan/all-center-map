import Mathlib

/-!
# Exact endpoint certificate for Ford's weak contraction

The polynomial below is the cleared-denominator `z = x`, `t = 1/200`
endpoint for the second contraction.  The proof uses its degree-four
Bernstein expansion on `[1/100,1/10]`; all five Bernstein coefficients after
subtracting `1/1250` are positive.
-/

namespace MAPFordWeakEndpoint

noncomputable section
set_option maxHeartbeats 3000000
set_option maxRecDepth 100000

theorem second_endpoint_quartic_lower_bound
    {x : ℝ} (hx0 : (1 / 100 : ℝ) ≤ x) (hx1 : x ≤ (1 / 10 : ℝ)) :
    -x ^ 4 / 4 - (201 : ℝ) * x ^ 3 / 400
        + (83761 : ℝ) * x ^ 2 / 160000
        - (233199 : ℝ) * x / 16000000
        + (8001 : ℝ) / 8000000 ≥ (1 : ℝ) / 1250 := by
  let y : ℝ := (100 * x - 1) / 9
  have hy0 : 0 ≤ y := by
    dsimp [y]
    nlinarith
  have hy1 : y ≤ 1 := by
    dsimp [y]
    nlinarith
  have hrepr :
      (-x ^ 4 / 4 - (201 : ℝ) * x ^ 3 / 400
          + (83761 : ℝ) * x ^ 2 / 160000
          - (233199 : ℝ) * x / 16000000
          + (8001 : ℝ) / 8000000) - (1 : ℝ) / 1250 =
        (84977 : ℝ) / 800000000 * (1 - y) ^ 4
          + 4 * ((66871 : ℝ) / 6400000000) * y * (1 - y) ^ 3
          + 6 * ((961369 : ℝ) / 1600000000) * y ^ 2 * (1 - y) ^ 2
          + 4 * ((11417851 : ℝ) / 6400000000) * y ^ 3 * (1 - y)
          + ((552031 : ℝ) / 160000000) * y ^ 4 := by
    dsimp [y]
    ring
  have hnon : 0 ≤
      (-x ^ 4 / 4 - (201 : ℝ) * x ^ 3 / 400
          + (83761 : ℝ) * x ^ 2 / 160000
          - (233199 : ℝ) * x / 16000000
          + (8001 : ℝ) / 8000000) - (1 : ℝ) / 1250 := by
    rw [hrepr]
    positivity
  linarith

theorem first_endpoint_quartic_z_eq_x_nonneg
    {x : ℝ} (hx0 : (1 / 10 : ℝ) ≤ x) (hx1 : x ≤ (1 / 2 : ℝ)) :
    -(119999 : ℝ) / 8000000 + (3478801 : ℝ) * x / 16000000
        + (17201 : ℝ) * x ^ 2 / 160000 - (121 : ℝ) * x ^ 3 / 400
        - x ^ 4 / 4 ≥ 0 := by
  let y : ℝ := (10 * x - 1) / 4
  have hy0 : 0 ≤ y := by
    dsimp [y]
    nlinarith
  have hy1 : y ≤ 1 := by
    dsimp [y]
    nlinarith
  have hrepr :
      -(119999 : ℝ) / 8000000 + (3478801 : ℝ) * x / 16000000
          + (17201 : ℝ) * x ^ 2 / 160000 - (121 : ℝ) * x ^ 3 / 400
          - x ^ 4 / 4 =
        (1198431 : ℝ) / 160000000 * (1 - y) ^ 4
          + 4 * ((1215013 : ℝ) / 40000000) * y * (1 - y) ^ 3
          + 6 * ((25587499 : ℝ) / 480000000) * y ^ 2 * (1 - y) ^ 2
          + 4 * ((5587687 : ℝ) / 80000000) * y ^ 3 * (1 - y)
          + ((429771 : ℝ) / 6400000) * y ^ 4 := by
    dsimp [y]
    ring
  rw [hrepr]
  positivity

theorem first_endpoint_quartic_z_eq_x_sub_t_nonneg
    {x : ℝ} (hx0 : (1 / 10 : ℝ) ≤ x) (hx1 : x ≤ (1 / 2 : ℝ)) :
    -(60299 : ℝ) / 4000000 + (3511079 : ℝ) * x / 16000000
        + (16481 : ℝ) * x ^ 2 / 160000 - (119 : ℝ) * x ^ 3 / 400
        - x ^ 4 / 4 ≥ 0 := by
  let y : ℝ := (10 * x - 1) / 4
  have hy0 : 0 ≤ y := by
    dsimp [y]
    nlinarith
  have hy1 : y ≤ 1 := by
    dsimp [y]
    nlinarith
  have hrepr :
      -(60299 : ℝ) / 4000000 + (3511079 : ℝ) * x / 16000000
          + (16481 : ℝ) * x ^ 2 / 160000 - (119 : ℝ) * x ^ 3 / 400
          - x ^ 4 / 4 =
        (1212329 : ℝ) / 160000000 * (1 - y) ^ 4
          + 4 * ((1223557 : ℝ) / 40000000) * y * (1 - y) ^ 3
          + 6 * ((25712461 : ℝ) / 480000000) * y ^ 2 * (1 - y) ^ 2
          + 4 * ((5612253 : ℝ) / 80000000) * y ^ 3 * (1 - y)
          + ((2162737 : ℝ) / 32000000) * y ^ 4 := by
    dsimp [y]
    ring
  rw [hrepr]
  positivity

theorem second_endpoint_quartic_z_eq_x_sub_t_lower_bound
    {x : ℝ} (hx0 : (1 / 100 : ℝ) ≤ x) (hx1 : x ≤ (1 / 10 : ℝ)) :
    -(1 : ℝ) * x ^ 4 / 4 - (199 : ℝ) * x ^ 3 / 400
        + (83361 : ℝ) * x ^ 2 / 160000
        - (235561 : ℝ) * x / 16000000
        + (21713 : ℝ) / 20000000 ≥ (1 : ℝ) / 1250 := by
  let y : ℝ := (100 * x - 1) / 9
  have hy0 : 0 ≤ y := by
    dsimp [y]
    nlinarith
  have hy1 : y ≤ 1 := by
    dsimp [y]
    nlinarith
  have hrepr :
      (-(1 : ℝ) * x ^ 4 / 4 - (199 : ℝ) * x ^ 3 / 400
          + (83361 : ℝ) * x ^ 2 / 160000
          - (235561 : ℝ) * x / 16000000
          + (21713 : ℝ) / 20000000) - (1 : ℝ) / 1250 =
        (7601 : ℝ) / 40000000 * (1 - y) ^ 4
          + 4 * ((574973 : ℝ) / 6400000000) * y * (1 - y) ^ 3
          + 6 * ((538129 : ℝ) / 800000000) * y ^ 2 * (1 - y) ^ 2
          + 4 * ((11814389 : ℝ) / 6400000000) * y ^ 3 * (1 - y)
          + ((560153 : ℝ) / 160000000) * y ^ 4 := by
    dsimp [y]
    ring
  have hnon : 0 ≤
      (-(1 : ℝ) * x ^ 4 / 4 - (199 : ℝ) * x ^ 3 / 400
          + (83361 : ℝ) * x ^ 2 / 160000
          - (235561 : ℝ) * x / 16000000
          + (21713 : ℝ) / 20000000) - (1 : ℝ) / 1250 := by
    rw [hrepr]
    positivity
  linarith


