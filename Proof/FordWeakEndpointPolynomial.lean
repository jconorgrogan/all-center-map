    let z : ℝ := x - v * t
    let q : ℝ := 1 - z + z ^ 2 / 2 - x + t * (z / 2 + 1)
    let target : ℝ := (7 : ℝ) * x / 5
    0 ≤ 2 * (1 - z) ^ 2 - q * (1 - z + q - t ^ 2) - 2 * (1 - z) ^ 2 * target := by
