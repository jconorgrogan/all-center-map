    let z : ℝ := x - v * t
    let q : ℝ := 1 - z + z ^ 2 / 2 - x + t * (z / 2 + 1)
    (7 : ℝ) * x / 5 ≤
      1 - q * (1 - z + q - t ^ 2) / (2 * (1 - z) ^ 2) := by
  dsimp
  let z : ℝ := x - v * t
  let q : ℝ := 1 - z + z ^ 2 / 2 - x + t * (z / 2 + 1)
  have hN := first_full_cleared_nonneg hx0 hx1 ht0 ht1 hv0 hv1
  have hvt : v * t ≤ (1 : ℝ) / 200 := by
    calc
      v * t ≤ 1 * t := mul_le_mul_of_nonneg_right hv1 ht0
      _ ≤ (1 : ℝ) / 200 := by simpa using ht1
  have hu : 0 < 1 - z := by
    dsimp [z]
    nlinarith
  have hden : 0 < 2 * (1 - z) ^ 2 := by positivity
  have hrewrite :
      (1 - q * (1 - z + q - t ^ 2) / (2 * (1 - z) ^ 2)) - (7 : ℝ) * x / 5 =
        (2 * (1 - z) ^ 2 - q * (1 - z + q - t ^ 2) -
          2 * (1 - z) ^ 2 * ((7 : ℝ) * x / 5)) /
          (2 * (1 - z) ^ 2) := by
    field_simp <;> ring
  rw [← sub_nonneg, hrewrite]
  exact div_nonneg hN (le_of_lt hden)

theorem second_full_contraction
    {x t v : ℝ} (hx0 : (1 / 100 : ℝ) ≤ x) (hx1 : x ≤ (1 / 10 : ℝ))
    (ht0 : 0 ≤ t) (ht1 : t ≤ (1 / 200 : ℝ))
    (hv0 : 0 ≤ v) (hv1 : v ≤ 1) :
    let z : ℝ := x - v * t
    let q : ℝ := 1 - z + z ^ 2 / 2 - x + t * (z / 2 + 1)
    (3 : ℝ) * x / 2 - 1 / 125 ≤
      1 - q * (1 - z + q - t ^ 2) / (2 * (1 - z) ^ 2) := by
  dsimp
  let z : ℝ := x - v * t
  let q : ℝ := 1 - z + z ^ 2 / 2 - x + t * (z / 2 + 1)
  have hN := second_full_cleared_nonneg hx0 hx1 ht0 ht1 hv0 hv1
  have hvt : v * t ≤ (1 : ℝ) / 200 := by
    calc
      v * t ≤ 1 * t := mul_le_mul_of_nonneg_right hv1 ht0
      _ ≤ (1 : ℝ) / 200 := by simpa using ht1
  have hu : 0 < 1 - z := by
    dsimp [z]
    nlinarith
  have hden : 0 < 2 * (1 - z) ^ 2 := by positivity
  have hrewrite :
      (1 - q * (1 - z + q - t ^ 2) / (2 * (1 - z) ^ 2)) -
          ((3 : ℝ) * x / 2 - 1 / 125) =
        (2 * (1 - z) ^ 2 - q * (1 - z + q - t ^ 2) -
          2 * (1 - z) ^ 2 * ((3 : ℝ) * x / 2 - 1 / 125)) /
          (2 * (1 - z) ^ 2) := by
    field_simp <;> ring
  rw [← sub_nonneg, hrewrite]
  exact div_nonneg hN (le_of_lt hden)

